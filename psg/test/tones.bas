10 REM COCO PSG TONE TEST
20 DEF FNP(F)=INT(2000000/(16*F)+.5)
30 POKE &HFF5E,7:POKE &HFF5F,56
40 FOR C=0 TO 2:POKE &HFF5E,8+C:POKE &HFF5F,12:NEXT
50 READ A,B,D:IF A=0 THEN 100
60 P=FNP(A):POKE &HFF5E,0:POKE &HFF5F,P AND 255:POKE &HFF5E,1:POKE &HFF5F,INT(P/256)
70 P=FNP(B):POKE &HFF5E,2:POKE &HFF5F,P AND 255:POKE &HFF5E,3:POKE &HFF5F,INT(P/256)
80 P=FNP(D):POKE &HFF5E,4:POKE &HFF5F,P AND 255:POKE &HFF5E,5:POKE &HFF5F,INT(P/256)
90 FOR T=1 TO 400:NEXT:GOTO 50
100 PRINT "1MHZ CLOCK (OCTAVE DOWN)":POKE &HFF5D,17:FOR T=1 TO 1500:NEXT
110 POKE &HFF5D,16:POKE &HFF5E,7:POKE &HFF5F,63:PRINT "DONE"
120 DATA 262,330,392, 294,349,440, 330,392,494, 349,440,523, 0,0,0
